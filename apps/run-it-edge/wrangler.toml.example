# An example for Cloudflare Workers, if that is the host Sean picks (#265). It holds no secret: set
# GITHUB_TOKEN and VISITOR_SALT in the dashboard Secrets fields, never in this file.
# Click-by-click guide: docs/run-it-deploy.md. Keep closed until the closed smoke check passes.
name = "expectrail-run-it"
main = "worker.js"
compatibility_date = "2026-11-01"
workers_dev = false
preview_urls = false

routes = [{ pattern = "api.expectrail.tech", custom_domain = true }]

[vars]
RUN_IT_OPEN = "false"
# The recorded-fix card is refused until its real repair recording exists (#433); then set "true".
RECORDED_FIX_OPEN = "false"
BREAKER_EPOCH = "0"
PER_VISITOR = "3"
DAILY_CAP = "40"
BREAKER = "3"
ALLOWED_ORIGINS = "https://expectrail.tech"

[[durable_objects.bindings]]
name = "RUN_IT"
class_name = "RunIt"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["RunIt"]
