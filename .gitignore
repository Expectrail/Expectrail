# Godot editor cache and our run output
.godot/
/runs/
/tools/*
!/tools/__init__.py
!/tools/merge_guard.py
!/tools/outside_trial.py
!/tools/outside_vision.py
!/tools/quickstart.py
!/tools/front_door.py
!/tools/runit_stub.py
!/tools/runit_burst.py
!/tools/release_gate.py
# The private held-out set when checked out locally or in CI (never commit it)
/heldout-set/
# Python
/build/
# Exists only inside a wheel (expectrail/resources.py). Never in the repository.
/expectrail/_bundle/
/dist/
*.egg-info/
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Secrets never go in the repo
.env
*.key
*.pem

# The planning tool's per-machine render cache (keyed by the local checkout folder)
_bmad/render/
