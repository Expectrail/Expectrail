; Pause Input: a small Godot project for Expectrail's own tests.
; A key pauses the whole scene tree, the way a game's pause menu does.

config_version=5

[application]

config/name="Pause Input"
config/description="A marker that walks right and stands still while the game is paused."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=360

[input]

right={
"deadzone": 0.5,
"events": []
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
