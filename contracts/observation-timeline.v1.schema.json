{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Expectrail/Expectrail/contracts/observation-timeline.v1.schema.json",
  "title": "Per-run capture timeline, from the harness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "traceSha256",
    "physicsTicksPerSecond",
    "captureFps",
    "frames"
  ],
  "properties": {
    "format": {
      "const": "expectrail.observation-timeline/v1"
    },
    "traceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "physicsTicksPerSecond": {
      "type": "integer",
      "minimum": 1
    },
    "captureFps": {
      "type": "integer",
      "minimum": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame",
          "tick",
          "tickInterval",
          "phase",
          "viewport",
          "transform",
          "sourceSha256"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "tickInterval": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "phase": {
            "enum": [
              "post-physics-pre-draw",
              "post-draw"
            ]
          },
          "viewport": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "transform": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          },
          "sourceSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
