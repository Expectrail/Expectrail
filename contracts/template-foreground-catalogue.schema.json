{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caller-selected pose catalogue from trusted clean art; not an approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "objects"
  ],
  "properties": {
    "format": {
      "const": "expectrail.foreground-catalogue/v1"
    },
    "objects": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artPath",
          "spriteGrid",
          "poses",
          "sourceScene"
        ],
        "properties": {
          "artPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "spriteGrid": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "poses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            }
          },
          "sourceScene": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
