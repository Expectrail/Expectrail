                "frame",
                "frameSha256",
                "replaySha256",
                "expectedBox",
                "detections",
                "error"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "frameSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "replaySha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
