              "type": "object",
              "additionalProperties": false,
              "required": [
                "frame",
                "frameSha256",
                "replaySha256",
                "expectedBox",
                "detections",
                "error"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "frameSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "replaySha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "expectedBox": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "detections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "box",
                      "score"
                    ],
                    "properties": {
                      "box": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "maxItems": 256
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "maxItems": 2048
          }
        }
      },
      "minItems": 1,
      "maxItems": 32
    },
    "selected": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
