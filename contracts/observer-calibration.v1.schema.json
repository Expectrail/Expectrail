{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "machineWritten",
    "observer",
    "art",
    "artSha256",
    "minimumFloor",
    "candidates",
    "selected",
    "clean",
    "broken",
    "enabled",
    "why",
    "missed"
  ],
  "properties": {
    "format": {
      "const": "expectrail.observer-calibration/v1"
    },
    "machineWritten": {
      "const": true
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "evidence",
        "sourceSha256"
