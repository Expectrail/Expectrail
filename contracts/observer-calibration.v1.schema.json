                    ],
                    "properties": {
                      "box": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "maxItems": 256
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "maxItems": 2048
          }
        }
      },
      "minItems": 4,
      "maxItems": 4
