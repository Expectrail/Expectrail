  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expectrail.tech/contracts/observer-calibration.v1.schema.json",
  "title": "expectrail.observer-calibration/v1",
  "description": "Offline observer-neutral selection and disjoint clean/broken proof. IoU >=0.5, at least 8 frames, floor=max(observer minimum, minimum correct clean confidence minus 0.05). Reader recomputes every result. Not an approval; never changes anchored RULES."
}
