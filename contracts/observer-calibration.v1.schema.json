      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "model",
            "provider"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "evidence": {
          "enum": [
            "recorded-sam",
            "no-model",
            "stand-in"
          ]
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "art": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "artSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimumFloor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
