{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/replay.schema.json",
  "title": "Replay: what the harness captured for one route on one exact game",
  "type": "object",
  "required": [
    "format",
    "route",
    "game",
    "engine",
    "capture",
    "frameSha256"
  ],
  "properties": {
    "format": {
      "enum": ["expectrail.replay/v0"]
    },
    "route": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "tree"
      ],
      "properties": {
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "patchSha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "description": "The engine that replayed the route. godot and unity are game engines; a web page names its browser engine (harness/web/run.py writes chromium) or web when it does not record one. Each adapter in harness/adapters.py records which it writes.",
          "enum": ["godot", "unity", "web", "chromium"]
        },
        "version": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "fps",
        "frames",
        "pattern"
      ],
      "properties": {
        "fps": {
          "type": "integer"
        },
        "physicsTicksPerSecond": {
          "type": [
            "integer",
            "null"
          ]
        },
        "frames": {
          "type": "integer"
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "frameSha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
