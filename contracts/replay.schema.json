{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/replay.schema.json",
  "title": "Replay: what the harness captured for one route on one exact game",
  "type": "object",
  "required": [
    "format",
    "route",
    "game",
    "engine",
    "capture",
    "frameSha256"
  ],
  "properties": {
    "format": {
      "enum": ["expectrail.replay/v0"]
    },
    "route": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "tree"
      ],
      "properties": {
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "patchSha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "description": "The engine that replayed the route. godot and unity are game engines; a web page names its browser engine (harness/web/run.py writes chromium) or web when it does not record one. Each adapter in harness/adapters.py records which it writes.",
          "enum": ["godot", "unity", "web", "chromium"]
        },
        "version": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "fps",
        "frames",
        "pattern"
      ],
      "properties": {
        "fps": {
          "type": "integer"
        },
        "physicsTicksPerSecond": {
          "type": [
            "integer",
            "null"
          ]
        },
        "frames": {
          "type": "integer"
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "frameSha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "seed": {
      "description": "The seed the game's random stream was given (the route's). Unity only.",
      "type": "integer"
    },
    "build": {
      "description": "Unity only: the player that was replayed, named by the digest of what it was built from (harness/unity/run.py, build_key).",
      "type": "object",
      "required": ["key", "unityVersion"],
      "properties": {
        "key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "unityVersion": {"type": "string"}
      }
    },
    "settle": {
      "description": "Unity only: what ran before tick 0. ticks counts the physics ticks the game ran (the same on every run); frozenFrames counts frames held with Time.timeScale at 0 while a fade that runs on real time finished (it varies with the machine's speed, and no frame of it is captured).",
      "type": "object",
      "required": ["ticks", "frozenFrames"],
      "properties": {
        "ticks": {"type": "integer", "minimum": 0},
        "frozenFrames": {"type": "integer", "minimum": 0}
      }
    },
    "hazards": {
      "description": "Unity only: things the harness found that can make two replays differ.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "properties": {
          "kind": {"type": "string"},
          "detail": {"type": "string"},
          "tick": {"type": ["integer", "null"]}
        }
      }
    },
    "integrity": {
      "description": "Unity only: the exceptions and errors the game logged during the run (Application.logMessageReceived), counted, the first 50 listed.",
      "type": "object",
      "required": ["exceptions", "errors", "messages"],
      "properties": {
        "exceptions": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "messages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["type", "message"],
            "properties": {
              "type": {"enum": ["Exception", "Error", "Assert"]},
              "message": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
