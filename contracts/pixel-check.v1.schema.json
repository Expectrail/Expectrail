{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/pixel-check.v1.schema.json",
  "title": "Pixel check: one generated check about what is drawn, judged from a trusted observer's answers",
  "description": "Issue #286. The closed shape a generated check takes when it speaks about the screen rather than the engine's record. The object is a role the project binds (never free text); the observer is a trusted one (expectrail/jit/pixel.py OBSERVERS) and a check asking what that observer cannot tell is refused when it is proposed. The predicates are the reference evaluator's (expectrail/evaluator.py). A model proposing a check does not approve it: authority is always model_prior and there is no approval field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "statement", "object", "observer", "probe", "predicate", "authority", "origin"],
  "properties": {
    "format": {"const": "expectrail.pixel-check/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 80},
    "statement": {"type": "string", "minLength": 1, "maxLength": 300,
                  "description": "What the check says, in a sentence. Data, not an instruction to anything."},
    "object": {"$ref": "#/$defs/role"},
    "observer": {"enum": ["sam-3.1-anchor", "visual-sensor"],
                 "description": "sam-3.1-anchor: SAM 3.1 asked about the place the engine's record puts the object (agents/sam_anchor.py). visual-sensor: the no-model sensor of #262, refused until it exists."},
    "probe": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 80,
              "description": "The route or probe whose frames the check judges."},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromFrame"],
      "properties": {
        "fromFrame": {"type": "integer", "minimum": 0},
        "toFrame": {"type": "integer", "minimum": 0}
      }
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "visible"},
            "minFraction": {"type": "number", "minimum": 0, "maximum": 1},
            "minScore": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "region"],
          "properties": {
            "type": {"const": "inside-region"},
            "region": {
              "type": "object",
              "additionalProperties": false,
              "required": ["engine"],
              "properties": {
                "engine": {"$ref": "#/$defs/role"},
                "marginPx": {"type": "number", "minimum": 0, "maximum": 400}
              },
              "description": "The box the engine's record gives this role in the frame, widened by marginPx."
            },
            "tolerancePx": {"type": "number", "minimum": 0, "maximum": 400},
            "minScore": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "boundary"],
          "properties": {
            "type": {"const": "never-crosses"},
            "boundary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["side", "value"],
              "properties": {
                "side": {"enum": ["above", "below", "left-of", "right-of"]},
                "value": {"type": "number", "minimum": 0, "maximum": 10000},
                "tolerancePx": {"type": "number", "minimum": 0, "maximum": 400}
              }
            },
            "minScore": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "goal"],
          "properties": {
            "type": {"const": "reaches"},
            "goal": {"$ref": "#/$defs/role"},
            "distancePx": {"type": "number", "minimum": 0, "maximum": 400},
            "minScore": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "authority": {"const": "model_prior"},
    "origin": {"const": "AUTO_DIFF"}
  },
  "$defs": {
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$",
             "description": "A role the project binds to an object in the game (#259); not a description."}
  }
}
