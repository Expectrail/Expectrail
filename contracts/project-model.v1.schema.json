{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expectrail.project-model/v1",
  "title": "Pinned reference model for drafting a paired setup obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "reference", "constraint", "sources", "evidence"],
  "properties": {
    "format": {"const": "expectrail.project-model/v1"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeSha256", "profileSha256", "bindingsSha256", "harnessSha256", "engine", "route", "capture"],
      "properties": {
        "treeSha256": {"$ref": "#/$defs/sha"},
        "profileSha256": {"$ref": "#/$defs/sha"},
        "bindingsSha256": {"$ref": "#/$defs/sha"},
        "harnessSha256": {"$ref": "#/$defs/sha"},
        "engine": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"],
          "properties": {
            "name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha"}
          }
        },
        "route": {
          "type": "object", "additionalProperties": false, "required": ["name", "sha256", "ticks"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64},
            "sha256": {"$ref": "#/$defs/sha"}, "ticks": {"type": "integer", "minimum": 2, "maximum": 1800}
          }
        },
        "capture": {
          "type": "object", "additionalProperties": false,
          "required": ["viewport", "ticksPerSecond", "framesPerSecond"],
          "properties": {
            "viewport": {"type": "array", "minItems": 2, "maxItems": 2,
                         "items": {"type": "integer", "minimum": 1, "maximum": 10000}},
            "ticksPerSecond": {"type": "integer", "minimum": 1},
            "framesPerSecond": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "constraint": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "subject", "axis", "coordinateSpace", "units", "minimum", "maximum"],
      "properties": {
        "kind": {"const": "fixed-axis-band"}, "subject": {"$ref": "#/$defs/text"},
        "axis": {"const": "y"}, "coordinateSpace": {"const": "world"}, "units": {"const": "pixels"},
        "minimum": {"type": "number"}, "maximum": {"type": "number"}
      }
    },
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "location", "property"],
        "properties": {
          "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha"},
          "location": {"$ref": "#/$defs/text"}, "property": {"$ref": "#/$defs/text"}
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["traceSha256", "transform", "firstTick", "lastTick", "goalTick", "returnTick"],
      "properties": {
        "traceSha256": {"$ref": "#/$defs/sha"}, "transform": {"const": "identity"},
        "firstTick": {"const": 0}, "lastTick": {"type": "integer", "minimum": 1},
        "goalTick": {"type": "integer", "minimum": 0}, "returnTick": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
