{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/findings.schema.json",
  "title": "Findings: the CI gate's verdict on a pull request, and the checks behind it",
  "description": "Written by the gate's verify step (expectrail.gate.verify), in the job that runs the pull request's code. Read by the gate's comment step (expectrail.gate.comment), in a separate job that treats it as untrusted data: it is size-capped, parsed with duplicate keys and non-finite numbers refused, checked against this schema with the standard-library validator in expectrail.gate.record, and checked for consistency (every finding id is recomputed, every count recounted, the decision decided again). Held-out routes appear as counts only: this schema has no place for their names.",
  "type": "object",
  "required": [
    "format",
    "decision",
    "reasons",
    "adapter",
    "pullRequest",
    "game",
    "checksFrom",
    "checksChanged",
    "specs",
    "drafts",
    "routes",
    "counts",
    "checks",
    "findings",
    "heldOut",
    "reviewPage",
    "expectrail",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "expectrail.findings/v0"
    },
    "decision": {
      "enum": ["accept", "reject", "needs-review"],
      "description": "accept only when at least one check ran and every public and held-out check passes; any failure rejects; anything else needs review"
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "adapter": {
      "enum": ["godot"],
      "description": "how the game was replayed; the Godot harness is the only one until the adapter boundary lands"
    },
    "pullRequest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["number", "headSha", "baseSha"],
          "additionalProperties": false,
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "headSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "baseSha": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      ]
    },
    "game": {
      "type": "object",
      "required": ["path", "headTree", "baseTree"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(\\.|[A-Za-z0-9_][A-Za-z0-9._/-]*)$",
          "description": "the Godot project folder, relative to the repository root (. for the root)"
        },
        "headTree": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseTree": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checksFrom": {
      "enum": ["base", "head"],
      "description": "base: the specs and routes were read from the pull request's base commit, so the change cannot edit the checks that judge it"
    },
    "checksChanged": {
      "type": "object",
      "required": ["specs", "routes"],
      "additionalProperties": false,
      "description": "spec and route files that differ between the base and the head (added, removed or edited), counted, not named",
      "properties": {
        "specs": {
          "type": "integer",
          "minimum": 0
        },
        "routes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "specs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "sha256", "instruction"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "instruction": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "drafts": {
      "type": "integer",
      "minimum": 0,
      "description": "spec files without a person's approval, which never judge a change"
    },
    "checkProblems": {
      "type": "integer",
      "minimum": 0,
      "description": "problems the gate found reading the spec and route files (a file refused or not valid, an id or a name used twice, a limit passed, nothing found where it was told to look), each named in the reasons. Above 0 the decision is never accept: the checks that ran are not all of the project's checks. Absent from records written before November 12, 2026, where such a problem did not change the decision; a reader takes an absent count as 0."
    },
    "routes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["checks", "passed", "failed", "needsReview"],
      "additionalProperties": false,
      "description": "the public checks after the change; needsReview includes replay errors",
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "needsReview": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 4096,
      "description": "one row per approved spec on each public route",
      "items": {
        "type": "object",
        "required": ["spec", "route", "before", "after", "comparison", "findingId"],
        "additionalProperties": false,
        "properties": {
          "spec": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "route": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "before": {
            "enum": ["pass", "fail", "needs-review", "replay-error", null],
            "description": "on the base commit; null when the base was not replayed"
          },
          "after": {
            "enum": ["pass", "fail", "needs-review", "replay-error"]
          },
          "comparison": {
            "enum": ["REPAIRED", "PRESERVED", "REGRESSION", "UNRESOLVED", "INCONCLUSIVE"],
            "description": "the review's words (docs/review.md); anything but pass or fail on either side is INCONCLUSIVE"
          },
          "findingId": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{12}$",
            "description": "null when the check passes after the change"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 4096,
      "description": "one per check that does not pass after the change",
      "items": {
        "type": "object",
        "required": ["id", "spec", "route", "kind", "before", "after", "comparison", "reason", "frame"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$",
            "description": "the first 12 hex digits of sha256(spec + LF + route + LF + kind): the same failure keeps its id across pushes"
          },
          "spec": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "route": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": ["fail", "needs-review", "replay-error"]
          },
          "before": {
            "enum": ["pass", "fail", "needs-review", "replay-error", null]
          },
          "after": {
            "enum": ["fail", "needs-review", "replay-error"]
          },
          "comparison": {
            "enum": ["REGRESSION", "UNRESOLVED", "INCONCLUSIVE"]
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          },
          "frame": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "the first failing frame after the change, when the evaluator names one"
          }
        }
      }
    },
    "heldOut": {
      "type": "object",
      "required": ["status", "routes", "checks", "passed", "failed", "needsReview"],
      "additionalProperties": false,
      "description": "counts only: no route names, files, frames or reasons",
      "properties": {
        "status": {
          "enum": ["not-used", "judged", "unavailable"]
        },
        "routes": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "needsReview": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "isolation": {
      "description": "Whether the game ran in the replay sandbox (docs/replay-sandbox.md), over every replay this record rests on: head, base and held-out. Counts and the tool only. Absent from records written before November 12, 2026, which a reader treats as not isolated.",
      "type": "object",
      "required": [
        "replays",
        "sandboxed",
        "required",
        "sandbox",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "replays": {
          "description": "Replays that finished and were judged.",
          "type": "integer",
          "minimum": 0
        },
        "sandboxed": {
          "description": "How many of them ran inside the sandbox: no network, own process tree, only the game's own files.",
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "description": "True when the gate was told to refuse to replay outside the sandbox.",
          "type": "boolean"
        },
        "sandbox": {
          "description": "The tool that isolated the sandboxed replays; null when none was.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "tool",
                "version"
              ],
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "enum": [
                    "bubblewrap"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            }
          ]
        },
        "reasons": {
          "description": "Why replays ran outside the sandbox, each distinct reason once.",
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "generatedChecks": {
      "type": "object",
      "description": "Optional and advisory (docs/jit.md): checks generated for this change. The decision rule never reads it; the decision follows from counts and heldOut alone.",
      "required": ["status", "reason", "proposed", "valid", "strong", "weak", "catches", "runSha256"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["not-run", "ran", "nothing-generated"]
        },
        "reason": {
          "type": ["string", "null"],
          "maxLength": 300
        },
        "proposed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "valid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "strong": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "weak": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "catches": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["specId", "statement", "strength"],
            "additionalProperties": false,
            "properties": {
              "specId": {
                "type": "string",
                "pattern": "^jit-[a-z0-9][a-z0-9._/-]{0,120}$"
              },
              "statement": {
                "type": "string",
                "maxLength": 200
              },
              "strength": {
                "enum": ["strong", "weak"]
              }
            }
          }
        },
        "runSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reviewPage": {
      "enum": ["review/index.html", null],
      "description": "the review page's path inside the artifact"
    },
    "expectrail": {
      "type": "object",
      "required": ["version", "commit"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9A-Za-z.+-]+$"
        },
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$",
          "description": "the Expectrail commit the action was pinned to, when it was used by commit"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
