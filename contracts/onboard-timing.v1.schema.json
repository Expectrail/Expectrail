{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expectrail.tech/contracts/onboard-timing.v1.schema.json",
  "title": "Onboard Timing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "startedAt",
    "readyAt",
    "machineSeconds",
    "humanSeconds",
    "approvedAt",
    "person",
    "state",
    "stages"
  ],
  "properties": {
    "format": {
      "const": "expectrail.onboard-timing/v1"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "readyAt": {
      "type": "string",
      "format": "date-time"
    },
    "machineSeconds": {
      "type": "number",
      "minimum": 0
    },
    "humanSeconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "person": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "review-ready",
        "approved",
        "declined"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "seconds",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "completed",
              "skipped",
              "failed"
            ]
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
