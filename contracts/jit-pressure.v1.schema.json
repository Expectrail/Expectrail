{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "status",
    "reason",
    "replays",
    "maxReplays",
    "fixerInvocations",
    "apiCapUsd",
    "rows",
    "adversarySuccesses",
    "expectedCases",
    "oracle",
    "sourceDigests"
  ],
  "properties": {
    "format": {
      "const": "expectrail.jit-pressure/v1"
    },
    "kind": {
      "enum": [
        "correct",
        "adversary"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "failed",
        "blocked"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "replays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "maxReplays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "fixerInvocations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "apiCapUsd": {
      "enum": [
        0,
        6
      ]
    },
    "adversarySuccesses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "specId",
          "outcomes"
        ],
        "properties": {
          "case": {
            "type": "string",
            "maxLength": 300
          },
          "specId": {
            "type": "string",
            "maxLength": 200
          },
          "outcomes": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "enum": [
                "pass",
                "fail",
                "not_exercised",
                "insufficient_observation",
                "execution_error"
              ]
            }
          }
        }
      }
    },
    "expectedCases": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "sourceDigests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "oracle": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clean",
            "bug",
            "candidate"
          ],
          "properties": {
            "clean": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "bug": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "candidate": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
