{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expectrail.tech/contracts/playtest-report.v1.schema.json",
  "title": "expectrail.playtest-report/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "producer",
    "target",
    "route",
    "bug",
    "fault"
  ],
  "properties": {
    "format": {
      "const": "expectrail.playtest-report/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "format",
        "name",
        "ticks",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "expectrail.route/v0"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string"
        },
        "ticks": {
          "type": "integer",
          "minimum": 1,
          "description": "physics ticks to run (the demo runs 120 per second)",
          "maximum": 1800
        },
        "seed": {
          "type": "integer"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tick",
              "action",
              "pressed"
            ],
            "additionalProperties": false,
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "action": {
                "type": "string",
                "description": "an input action defined by the game, e.g. move_right"
              },
              "pressed": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "$comment": "Embedded route.schema.json, with only the report tick cap added; kept equal by a regression test. No snapshot field is permitted."
    },
    "bug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S",
      "description": "User-supplied bug report, only with intent fix. Captured text, not a path to fetch, an approved check or proof of a repair. Control characters other than tab and line endings are refused by the reader."
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preFaultTick",
        "faultTick",
        "anchor"
      ],
      "properties": {
        "preFaultTick": {
          "type": "integer",
          "minimum": 0
        },
        "faultTick": {
          "type": "integer",
          "minimum": 1
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object",
            "x",
            "y",
            "tolerancePx"
          ],
          "properties": {
            "object": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "maxLength": 64
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "tolerancePx": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
