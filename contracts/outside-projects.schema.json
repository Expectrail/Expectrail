{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expectrail.outside-projects/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "projects"
  ],
  "properties": {
    "format": {
      "const": "expectrail.outside-projects/v0"
    },
    "note": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repository",
          "commit",
          "path",
          "licence",
          "kind",
          "routes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "licence": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "routes": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "config": {
            "type": "string"
          },
          "expect": {
            "enum": [
              "accept",
              "reject",
              "needs-review",
              "unapproved-drafts"
            ]
          },
          "engineExpect": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "additionalProperties": {
              "enum": [
                "pass",
                "fail",
                "needs-review",
                "not-applicable"
              ]
            }
          },
          "draftSpecs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "patch",
                "expect",
                "what"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "patch": {
                  "type": "string"
                },
                "expect": {
                  "enum": [
                    "accept",
                    "reject",
                    "needs-review",
                    "unapproved-drafts"
                  ]
                },
                "what": {
                  "type": "string"
                },
                "engineExpect": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "additionalProperties": {
                    "enum": [
                      "pass",
                      "fail",
                      "needs-review",
                      "not-applicable"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
