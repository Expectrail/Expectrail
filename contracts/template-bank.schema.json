{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": [
        "expectrail.template-bank/v0",
        "expectrail.template-bank/v1"
      ]
    },
    "config": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "expectrail.template-ncc/v2"
            },
            "coordinates": {
              "const": "captured-frame pixels; origin top-left; xyxy half-open; y down"
            },
            "matchThreshold": {
              "type": "number",
              "maximum": 1,
              "minimum": 1e-06
            },
            "agreementIoU": {
              "type": "number",
              "maximum": 1,
              "minimum": 1e-06
            },
            "searchMarginPx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "scales": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4
              },
              "minItems": 1,
              "maxItems": 9
            },
            "stridePx": {
              "const": 1
            },
            "sampleSide": {
              "type": "integer",
              "minimum": 4,
              "maximum": 32
            },
            "minimumContrast": {
              "type": "number",
              "minimum": 1,
              "maximum": 128
            }
          },
          "required": [
            "algorithm",
            "coordinates",
            "matchThreshold",
            "agreementIoU",
            "searchMarginPx",
            "scales",
            "stridePx",
            "sampleSide",
            "minimumContrast"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "expectrail.template-foreground/v3"
            },
            "coordinates": {
              "const": "captured-frame pixels; origin top-left; xyxy half-open; y down"
            },
            "matchThreshold": {
              "type": "number",
              "maximum": 1,
              "minimum": 1e-06
            },
            "agreementIoU": {
              "type": "number",
              "maximum": 1,
              "minimum": 1e-06
            },
            "searchMarginPx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "scales": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4
              },
              "minItems": 1,
              "maxItems": 9
            },
            "stridePx": {
              "const": 1
            },
            "sampleSide": {
              "type": "integer",
              "minimum": 4,
              "maximum": 32
            },
            "minimumContrast": {
              "type": "number",
              "minimum": 1,
              "maximum": 128
            },
            "foregroundPurity": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1
            },
            "rgbTolerance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "rasterTolerancePx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "confirmationCandidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "minimumForegroundBins": {
              "type": "integer",
              "minimum": 4,
              "maximum": 1024
            },
            "confirmationParts": {
              "const": 4
            }
          },
          "required": [
            "algorithm",
            "coordinates",
            "matchThreshold",
            "agreementIoU",
            "searchMarginPx",
            "scales",
            "stridePx",
            "sampleSide",
            "minimumContrast",
            "foregroundPurity",
            "rgbTolerance",
            "rasterTolerancePx",
            "confirmationCandidates",
            "minimumForegroundBins",
            "confirmationParts"
          ]
        }
      ]
    },
    "clean": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "replaySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "traceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "gameTree",
        "replaySha256",
        "traceSha256"
      ]
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "frameSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "width": {
            "type": "integer",
            "minimum": 4,
            "maximum": 512
          },
          "height": {
            "type": "integer",
            "minimum": 4,
            "maximum": 512
          },
          "pixels": {
            "type": "string",
            "maxLength": 350000
          },
          "pixelsSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "predictedBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "sourceReplaySha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mirrorX": {
            "type": "boolean"
          },
          "rgbPixels": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "rgbPixelsSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "foregroundMask": {
            "type": "string",
            "minLength": 1,
            "maxLength": 350000
          },
          "foregroundMaskSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "clean-capture",
              "approved-art-pose"
            ]
          },
          "artRegistration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "anchorPose",
              "pose",
              "scale",
              "offset",
              "agreement",
              "anchorRgbSha256"
            ],
            "properties": {
              "anchorPose": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "pose": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "scale": {
                "type": "number",
                "minimum": 1,
                "maximum": 4
              },
              "offset": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": -4096,
                  "maximum": 4096
                }
              },
              "agreement": {
                "type": "number",
                "minimum": 0.98,
                "maximum": 1
              },
              "anchorRgbSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "heading": {
            "enum": [
              "right",
              "left"
            ],
            "description": "A clean capture of an object whose facing is calibrated (calibration.objects.<role>.facing): the way the engine moved it on the captured tick, the opposite for its mirrored copy. Absent on a pose that looks the same mirrored, and on every other object."
          }
        },
        "required": [
          "object",
          "frame",
          "frameSha256",
          "box",
          "width",
          "height",
          "pixels",
          "pixelsSha256",
          "predictedBox",
          "sourceReplaySha256",
          "mirrorX"
        ]
      },
      "minItems": 1,
      "maxItems": 2048
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gameTree": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "replaySha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "traceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "gameTree",
          "replaySha256",
          "traceSha256"
        ]
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection": {
          "enum": [
            "explicit-frames",
            "all-clean-crops",
            "approved-foreground"
          ]
        },
        "selectionSimilarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceFrames": {
          "type": "integer",
          "minimum": 0
        },
        "eligibleFrames": {
          "type": "integer",
          "minimum": 0
        },
        "mirrored": {
          "type": "boolean"
        },
        "thresholdFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "thresholdSelected": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validationReplaySha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "positives": {
          "type": "integer",
          "minimum": 0
        },
        "negatives": {
          "type": "integer",
          "minimum": 0
        },
        "positiveMatches": {
          "type": "integer",
          "minimum": 0
        },
        "negativeMatches": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "not-run",
            "met",
            "unmet"
          ]
        },
        "objects": {
          "description": "Roles the game has many of (enemy, bullet), calibrated beside the player from the boxes the engine logs for them (agents/template_foreground.py calibrate_routes, objects). Each is validated on the validation replay at the threshold chosen on the player, with the player's rule: met when at least 95% of its positives and at most 1% of its negatives match. Absent: only the player was calibrated.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enemy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "templates",
                "positives",
                "negatives",
                "positiveMatches",
                "negativeMatches",
                "status"
              ],
              "properties": {
                "templates": {
                  "type": "integer",
                  "minimum": 0
                },
                "positives": {
                  "type": "integer",
                  "minimum": 0
                },
                "negatives": {
                  "type": "integer",
                  "minimum": 0
                },
                "positiveMatches": {
                  "type": "integer",
                  "minimum": 0
                },
                "negativeMatches": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "met",
                    "unmet"
                  ]
                },
                "facing": {
                  "description": "The object's facing (#286; agents/template_foreground.py _validate_facing), for objects whose sprite the game flips with their motion (the enemy). Its clean captures are labelled with the way the engine moved the cropped object (template heading), and on every validation frame showing it moving one way the drawn object is decided from the right- and left-labelled templates alone, and again with it mirrored in place. met by the player's rule on both: at least 95% decided right and at most 1% decided wrong, with templates both ways. The reader recomputes the status. Absent: the sensor does not tell which way this object faces.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "margin",
                    "templates",
                    "moving",
                    "agree",
                    "disagree",
                    "mirroredAgree",
                    "mirroredDisagree",
                    "status"
                  ],
                  "properties": {
                    "margin": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "templates": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "right",
                        "left"
                      ],
                      "properties": {
                        "right": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "left": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "moving": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "agree": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "disagree": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mirroredAgree": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mirroredDisagree": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "enum": [
                        "met",
                        "unmet"
                      ]
                    }
                  }
                }
              }
            },
            "bullet": {
              "$comment": "the same shape as enemy",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "templates",
                "positives",
                "negatives",
                "positiveMatches",
                "negativeMatches",
                "status"
              ],
              "properties": {
                "templates": {
                  "type": "integer",
                  "minimum": 0
                },
                "positives": {
                  "type": "integer",
                  "minimum": 0
                },
                "negatives": {
                  "type": "integer",
                  "minimum": 0
                },
                "positiveMatches": {
                  "type": "integer",
                  "minimum": 0
                },
                "negativeMatches": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "met",
                    "unmet"
                  ]
                },
                "witness": {
                  "description": "How this object is witnessed. Absent: by its templates (template_foreground.py). \"radial\": by the radial witness in radialWitnesses.<role> (agents/template_radial.py), for a round sprite that rotates; then templates counts its clean ring profiles.",
                  "const": "radial"
                }
              }
            }
          }
        }
      },
      "required": [
        "selection",
        "selectionSimilarity",
        "sourceFrames",
        "eligibleFrames",
        "mirrored",
        "thresholdFloor",
        "thresholdSelected",
        "validationReplaySha256",
        "positives",
        "negatives",
        "positiveMatches",
        "negativeMatches",
        "status"
      ]
    },
    "foregroundSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "path",
          "sha256",
          "alphaMinimum",
          "paletteRgb"
        ],
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "alphaMinimum": {
            "const": 250
          },
          "paletteRgb": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 2,
            "maxItems": 4096
          },
          "catalogue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artPath",
              "spriteGrid",
              "poses",
              "sourceScene"
            ],
            "properties": {
              "artPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "spriteGrid": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "poses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                }
              },
              "sourceScene": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "artSize": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "rgbaPixels": {
            "type": "string",
            "minLength": 1,
            "maxLength": 22369624
          },
          "rgbaPixelsSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "oneOf": [
          {
            "properties": {
              "catalogue": {
                "type": "null"
              },
              "artSize": {
                "type": "null"
              },
              "rgbaPixels": {
                "type": "null"
              },
              "rgbaPixelsSha256": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "catalogue",
              "artSize",
              "rgbaPixels",
              "rgbaPixelsSha256"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 64
    },
    "groundReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinates",
        "sourceReplaySha256",
        "sourceTraceSha256",
        "polygons"
      ],
      "properties": {
        "coordinates": {
          "const": "trusted clean world coordinates; y down"
        },
        "sourceReplaySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceTraceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "polygons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 64,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "radialWitnesses": {
      "description": "Round objects that rotate as they move (the bundled game's bullet, a RigidBody2D), witnessed without templates (#286; agents/template_radial.py). Each holds the mean colour of each one-pixel ring around the sprite's centre, measured on trusted clean replays only where the approved art locates the sprite on the path the engine logged; a frame is matched when some position on that path has rings within maxDistance of one of these. Ring means do not change when the sprite turns. Every role here has a calibration.objects record with witness radial.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bullet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "art",
            "sidePx",
            "rings",
            "pathTicks",
            "fadesAfterTicks",
            "clearPx",
            "locateFloor",
            "maxDistance",
            "profiles",
            "profilesSha256"
          ],
          "properties": {
            "algorithm": {
              "const": "expectrail.radial-witness/v1"
            },
            "art": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "sidePx": {
              "type": "integer",
              "minimum": 8,
              "maximum": 256
            },
            "rings": {
              "type": "integer",
              "minimum": 2,
              "maximum": 128
            },
            "pathTicks": {
              "description": "The frame draws the object somewhere between its logged box this many ticks earlier and its logged box on the frame's tick (physics interpolation).",
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "fadesAfterTicks": {
              "description": "From this age, in ticks since the object was first logged, the game fades it out; such a box is not judged (a gap). Null: it does not fade.",
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "clearPx": {
              "description": "How far, in frame pixels, the box of another object of the same role must stay from the area searched along the object's path for the object to be judged (the box of any other logged object must not touch that area). Nearer, it is a gap. Calibration keeps and validates by the same rule. 0 on the bundled game, measured on its calibration replays.",
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "locateFloor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxDistance": {
              "type": "number",
              "maximum": 255,
              "minimum": 0.1
            },
            "profiles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 512,
              "items": {
                "type": "array",
                "minItems": 6,
                "maxItems": 384,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            },
            "profilesSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "required": [
    "format",
    "config",
    "clean",
    "templates",
    "sources",
    "calibration"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clean-build template bank; provenance is pinned by the caller, not an approval",
  "oneOf": [
    {
      "properties": {
        "format": {
          "const": "expectrail.template-bank/v0"
        },
        "config": {
          "properties": {
            "algorithm": {
              "const": "expectrail.template-ncc/v2"
            }
          }
        },
        "foregroundSources": {
          "type": "null"
        },
        "groundReference": {
          "type": "null"
        },
        "templates": {
          "items": {
            "properties": {
              "rgbPixels": {
                "type": "null"
              },
              "rgbPixelsSha256": {
                "type": "null"
              },
              "foregroundMask": {
                "type": "null"
              },
              "foregroundMaskSha256": {
                "type": "null"
              },
              "kind": {
                "type": "null"
              },
              "artRegistration": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "required": [
        "foregroundSources"
      ],
      "properties": {
        "format": {
          "const": "expectrail.template-bank/v1"
        },
        "config": {
          "properties": {
            "algorithm": {
              "const": "expectrail.template-foreground/v3"
            }
          }
        },
        "templates": {
          "items": {
            "required": [
              "rgbPixels",
              "rgbPixelsSha256",
              "foregroundMask",
              "foregroundMaskSha256",
              "kind"
            ],
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "const": "clean-capture"
                  },
                  "artRegistration": {
                    "type": "null"
                  }
                }
              },
              {
