{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expectrail.tech/contracts/run-it-result.v1.schema.json",
  "title": "expectrail.run-it-result/v1",
  "description": "What one Run it visit produced (status.json beside viewer/ and findings.json). The decision is the verifier's; it is null unless the job completed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "requestId",
    "sample",
    "phase",
    "decision",
    "asExpected",
    "diagnostics",
    "vision",
    "receipt",
    "startedAt",
    "finishedAt",
    "expectrailCommit",
    "viewer",
    "findings"
  ],
  "properties": {
    "format": {
      "const": "expectrail.run-it-result/v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expected": {
          "enum": [
            "accept",
            "reject",
            "needs-review"
          ]
        }
      }
    },
    "phase": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "needs-review",
        null
      ]
    },
    "asExpected": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]{1,40}$"
          },
          "detail": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded",
        "recordedAt",
        "run",
        "model",
        "asked",
        "answered",
        "notRecorded",
        "why"
      ],
      "properties": {
        "recorded": {
          "type": "boolean"
        },
        "recordedAt": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "run": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "asked": {
          "type": "integer",
          "minimum": 0
        },
        "answered": {
          "type": "integer",
          "minimum": 0
        },
        "notRecorded": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed",
        "why"
      ],
      "properties": {
        "signed": {
          "const": false
        },
        "why": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "finishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expectrailCommit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "viewer": {
      "const": "viewer/index.html"
    },
    "findings": {
      "enum": [
        "findings.json",
        null
      ]
    }
  }
}
