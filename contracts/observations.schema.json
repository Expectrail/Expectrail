{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/observations.schema.json",
  "title": "Observations: objects found in captured frames",
  "description": "An object with an empty list was looked for and not found, except that template-sensor frames explicitly marked unavailable or out-of-frame are unmeasured advisory evidence. TemplateObserver refuses to return such incomplete documents for judging. An absent frame was not looked at.",
  "type": "object",
  "required": [
    "format",
    "replay",
    "model",
    "frames"
  ],
  "properties": {
    "format": {
      "enum": [
        "expectrail.observations/v0"
      ]
    },
    "replay": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "prompts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "sensor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "algorithm": {
                      "const": "expectrail.template-ncc/v2"
                    },
                    "coordinates": {
                      "const": "captured-frame pixels; origin top-left; xyxy half-open; y down"
                    },
                    "matchThreshold": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 1e-06
                    },
                    "agreementIoU": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 1e-06
                    },
                    "searchMarginPx": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 128
                    },
                    "scales": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0.25,
                        "maximum": 4
                      },
                      "minItems": 1,
                      "maxItems": 9
                    },
                    "stridePx": {
                      "const": 1
                    },
                    "sampleSide": {
                      "type": "integer",
                      "minimum": 4,
                      "maximum": 32
                    },
                    "minimumContrast": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 128
                    }
                  },
                  "required": [
                    "algorithm",
                    "coordinates",
                    "matchThreshold",
                    "agreementIoU",
                    "searchMarginPx",
                    "scales",
                    "stridePx",
                    "sampleSide",
                    "minimumContrast"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "algorithm": {
                      "const": "expectrail.template-foreground/v3"
                    },
                    "coordinates": {
                      "const": "captured-frame pixels; origin top-left; xyxy half-open; y down"
                    },
                    "matchThreshold": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 1e-06
                    },
                    "agreementIoU": {
                      "type": "number",
                      "maximum": 1,
                      "minimum": 1e-06
                    },
                    "searchMarginPx": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 128
                    },
                    "scales": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0.25,
                        "maximum": 4
                      },
                      "minItems": 1,
                      "maxItems": 9
                    },
                    "stridePx": {
                      "const": 1
                    },
                    "sampleSide": {
                      "type": "integer",
                      "minimum": 4,
                      "maximum": 32
                    },
                    "minimumContrast": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 128
                    },
                    "foregroundPurity": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 1
                    },
                    "rgbTolerance": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 8
                    },
                    "rasterTolerancePx": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2
                    },
                    "confirmationCandidates": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "minimumForegroundBins": {
                      "type": "integer",
                      "minimum": 4,
                      "maximum": 1024
                    },
                    "confirmationParts": {
                      "const": 4
                    }
                  },
                  "required": [
                    "algorithm",
                    "coordinates",
                    "matchThreshold",
                    "agreementIoU",
                    "searchMarginPx",
                    "scales",
                    "stridePx",
                    "sampleSide",
                    "minimumContrast",
                    "foregroundPurity",
                    "rgbTolerance",
                    "rasterTolerancePx",
                    "confirmationCandidates",
                    "minimumForegroundBins",
                    "confirmationParts"
                  ]
                }
              ]
            },
            "bankSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "clean": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gameTree": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "replaySha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "traceSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "gameTree",
                "replaySha256",
                "traceSha256"
              ]
            },
            "capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "presence",
                  "position",
                  "shape"
                ]
              },
              "minItems": 1
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "captureFps": {
              "type": "integer",
              "minimum": 1
            },
            "physicsTicksPerSecond": {
              "type": "integer",
              "minimum": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "gameTree": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "replaySha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "traceSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "gameTree",
                  "replaySha256",
                  "traceSha256"
                ]
              }
            },
            "calibration": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selection": {
                  "enum": [
                    "explicit-frames",
                    "all-clean-crops",
                    "approved-foreground"
                  ]
                },
                "selectionSimilarity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sourceFrames": {
                  "type": "integer",
                  "minimum": 0
                },
                "eligibleFrames": {
                  "type": "integer",
                  "minimum": 0
                },
                "mirrored": {
                  "type": "boolean"
                },
                "thresholdFloor": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "thresholdSelected": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "validationReplaySha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "positives": {
                  "type": "integer",
                  "minimum": 0
                },
                "negatives": {
                  "type": "integer",
                  "minimum": 0
                },
                "positiveMatches": {
                  "type": "integer",
                  "minimum": 0
                },
                "negativeMatches": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "not-run",
                    "met",
                    "unmet"
                  ]
                },
                "objects": {
                  "description": "Roles the game has many of (enemy, bullet), calibrated beside the player from the boxes the engine logs for them (agents/template_foreground.py calibrate_routes, objects). Each is validated on the validation replay at the threshold chosen on the player, with the player's rule: met when at least 95% of its positives and at most 1% of its negatives match. Absent: only the player was calibrated.",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enemy": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "templates",
                        "positives",
                        "negatives",
                        "positiveMatches",
                        "negativeMatches",
                        "status"
                      ],
                      "properties": {
                        "templates": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "positives": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "negatives": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "positiveMatches": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "negativeMatches": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "status": {
                          "enum": [
                            "met",
                            "unmet"
                          ]
                        }
                      }
                    },
                    "bullet": {
                      "$comment": "the same shape as enemy",
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "templates",
                        "positives",
                        "negatives",
                        "positiveMatches",
                        "negativeMatches",
                        "status"
                      ],
                      "properties": {
                        "templates": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "positives": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "negatives": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "positiveMatches": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "negativeMatches": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "status": {
                          "enum": [
                            "met",
                            "unmet"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "selection",
                "selectionSimilarity",
                "sourceFrames",
                "eligibleFrames",
                "mirrored",
                "thresholdFloor",
                "thresholdSelected",
                "validationReplaySha256",
                "positives",
                "negatives",
                "positiveMatches",
                "negativeMatches",
                "status"
              ]
            },
            "foregroundSources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "object",
                  "path",
                  "sha256",
                  "alphaMinimum",
                  "paletteRgb"
                ],
                "properties": {
                  "object": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "alphaMinimum": {
                    "const": 250
                  },
                  "paletteRgb": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "minItems": 2,
                    "maxItems": 4096
                  },
                  "catalogue": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "artPath",
                      "spriteGrid",
                      "poses",
                      "sourceScene"
                    ],
                    "properties": {
                      "artPath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "spriteGrid": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 64
                        }
                      },
                      "poses": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 4096,
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4095
                        }
                      },
                      "sourceScene": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "sha256"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        }
                      }
                    }
                  },
                  "artSize": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4096
                    }
                  },
                  "rgbaPixelsSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "minItems": 1,
              "maxItems": 64
            },
            "groundReferenceSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "config",
            "bankSha256",
            "clean",
            "capabilities",
            "limitations",
            "captureFps",
            "physicsTicksPerSecond",
            "sources",
            "calibration"
          ],
          "oneOf": [
            {
              "properties": {
                "config": {
                  "properties": {
                    "algorithm": {
                      "const": "expectrail.template-ncc/v2"
                    }
                  }
                },
                "foregroundSources": {
                  "type": "null"
                },
                "groundReferenceSha256": {
                  "type": "null"
                }
              }
            },
            {
              "required": [
                "foregroundSources"
              ],
              "properties": {
                "config": {
                  "properties": {
                    "algorithm": {
                      "const": "expectrail.template-foreground/v3"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "frame",
          "objects"
        ],
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "objects": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "box",
                  "score"
                ],
                "properties": {
                  "box": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "[x0, y0, x1, y1] in pixels of the captured frame, y down"
                  },
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "track": {
                    "type": "integer",
                    "description": "SAM 3.1 track id, stable across frames when tracking is used"
                  },
                  "mask": {
                    "type": "string",
                    "description": "optional path to a mask PNG or an RLE string"
                  }
                }
              }
            }
          },
          "sensor": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "matched",
                    "not-found",
                    "displaced",
                    "unavailable",
                    "out-of-frame"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "predictedBox": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "searchBox": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rawBox": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "templateFrame": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "scale": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "components": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ncc",
                        "foregroundCoverage",
                        "partCoverage"
                      ],
                      "properties": {
                        "ncc": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "foregroundCoverage": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 1
                        },
                        "partCoverage": {
                          "anyOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "array",
                              "minItems": 4,
                              "maxItems": 4,
                              "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "status",
                "reason",
                "predictedBox",
                "searchBox",
                "rawBox",
                "score",
                "templateFrame",
                "scale"
              ]
            }
          },
          "notDrawn": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "description": "Negative evidence from a calibrated anchored observer, not a provider error. Size/place mismatch counts only at the spec object confidence floor; no-match is a successful response with no region. At a clipped edge, comparisons use only the visible part; raw answer is retained.",
              "required": [
                "reason",
                "point",
                "scale",
                "expectedSize",
                "observedSize",
                "answer",
                "sizeTolerance",
                "sizeFloorPx"
              ],
              "properties": {
                "reason": {
                  "enum": [
                    "size-mismatch",
                    "no-match",
                    "place-mismatch"
                  ]
                },
                "point": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "The engine-derived question point in captured-frame pixels."
                },
                "scale": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "Captured-frame pixels per game pixel on each axis."
                },
                "expectedSize": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "Clean calibration drawnSize in game pixels, restricted to the visible part at the engine collision body centre when that body intersects an image edge."
                },
                "observedSize": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Answer dimensions in game pixels, restricted to the image at a clipped edge; null for a successful empty response."
                },
                "answer": {
                  "anyOf": [
                    {
                      "$ref": "#/properties/frames/items/properties/objects/additionalProperties/items"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The original answered box and score in captured-frame pixels; null for a successful empty answer."
                },
                "sizeTolerance": {
                  "const": 0.25
                },
                "sizeFloorPx": {
                  "const": 4.0
                },
                "expectedVisibleBox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "At a clipped edge only: clean calibrated rectangle at the logged body centre, intersected with the image, in captured-frame pixels. Raw answer remains in answer."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "reason": {
                        "const": "no-match"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "answer": {
                        "type": "null"
                      },
                      "observedSize": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "answer": {
                        "$ref": "#/properties/frames/items/properties/objects/additionalProperties/items"
                      },
                      "observedSize": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "reason": {
                        "const": "place-mismatch"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "expectedVisibleBox"
                    ]
                  }
                }
              ]
            },
            "description": "By spec object name: explicit evidence that the calibrated player was not drawn at its place. Absence of a detection without this evidence remains uncertainty, never an automatic reject."
          },
          "notExercised": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "outside-view"
              ]
            },
            "description": "By object name: the logged collision body has no positive-area intersection with the view. No question was sent. The evaluator treats it as unjudged, never a pass or negative visual evidence."
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "model": {
          "properties": {
            "sensor": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "properties": {
        "model": {
          "required": [
            "sensor"
          ],
          "properties": {
            "sensor": {
              "properties": {
                "config": {
                  "properties": {
                    "algorithm": {
                      "const": "expectrail.template-ncc/v2"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "model": {
          "required": [
            "sensor"
          ],
          "properties": {
            "sensor": {
              "properties": {
                "config": {
                  "properties": {
                    "algorithm": {
                      "const": "expectrail.template-foreground/v3"
                    }
                  }
                }
              }
            }
          }
        },
        "frames": {
          "items": {
            "properties": {
              "sensor": {
                "additionalProperties": {
                  "required": [
                    "components"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
