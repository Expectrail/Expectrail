{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expectrail.tech/contracts/playtest-reproduction.v1.schema.json",
  "title": "Playtest reproduction evidence; never a decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "advisory",
    "checks",
    "reason",
    "jitRunSha256",
    "baseTree",
    "cleanTree"
  ],
  "properties": {
    "format": {
      "const": "expectrail.playtest-reproduction/v1"
    },
    "kind": {
      "enum": [
        "approved",
        "generated-advisory",
        "none"
      ]
    },
    "advisory": {
      "const": true
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "jitRunSha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "baseTree": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "cleanTree": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    }
  }
}
