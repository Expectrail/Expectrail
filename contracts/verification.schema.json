{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/verification.schema.json",
  "title": "Verification: whether a candidate patch is accepted, decided outside the fixer's reach",
  "description": "accept only if every check passes; any fail rejects; anything else needs review. Passing means the candidate passed this suite, not that the game is correct.",
  "type": "object",
  "required": [
    "format",
    "candidate",
    "evaluator",
    "checks",
    "decision",
    "reasons"
  ],
  "properties": {
    "observers": {
      "type": "object",
      "required": [
        "rule",
        "visual"
      ],
      "additionalProperties": false,
      "description": "Observer policy for the legacy benchmark verifier. Engine-only is a diagnostic counterfactual, not product clearance. Version is the observation adapter release; model names remain provider identifiers.",
      "properties": {
        "rule": {
          "enum": [
            "both",
            "engine-only"
          ]
        },
        "engine": {
          "description": "Engine observation adapter and its Expectrail release version. Optional on historical records.",
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "visionEvery": {
          "type": "integer",
          "minimum": 1,
          "description": "Explicit opt-in visual stride for public checks, from each window's first frame plus its last. Absent means 1 (every frame). The engine and captured window must remain complete. A defect shorter than this many frames may be missed; three consecutive negative samples span up to 2*visionEvery+1 real frames, not proof about intervening pixels. Explicit spec coverage obligations are not relaxed. The paired anchor block keeps its own every."
        },
        "visual": {
          "description": "the visual observer that was asked; null when none was (under both, nothing is then accepted)",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "name",
                "provider",
                "model"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "version": {
                  "description": "Observation adapter version, not a claim about the provider weights revision; absent in historical records.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          ]
        }
      }
    },
    "format": {
      "enum": ["expectrail.verification/v0"]
    },
    "candidate": {
      "type": "object",
      "required": [
        "patchSha256",
        "baseTree",
        "attempt"
      ],
      "properties": {
        "patchSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "request": {
          "type": "string"
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the repair-request document that produced this verification"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spec",
          "kind",
          "route",
          "result"
        ],
        "properties": {
          "spec": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "regression",
              "gameplay",
              "held-out",
              "clean"
            ]
          },
          "route": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "needs-review"
            ]
          },
          "verdictSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "needs-review"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suite": {
      "type": "object",
      "description": "Optional provenance for candidate/clean/held-out observation sources (not required on early rejects). When present, all three arms are required.",
      "required": ["candidate", "clean", "heldOut"],
      "properties": {
        "candidate": { "$ref": "#/$defs/suiteArm" },
        "clean": { "$ref": "#/$defs/suiteArm" },
        "heldOut": { "$ref": "#/$defs/suiteArm" },
        "earlyReject": {
          "type": "object",
          "required": ["gate", "detail"],
          "additionalProperties": false,
          "properties": {
            "gate": {
              "enum": ["editable-globs", "base-tree"]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "suiteArm": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "harness",
            "fixture",
            "fixture-fallback",
            "interim-fixture",
            "unavailable",
            "path",
            "not-run"
          ]
        },
        "path": { "type": "string" },
        "observationsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "detail": { "type": "string" }
      }
    }
  }
}
