{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/test-spec.schema.json",
  "title": "Test spec: a plain-English check turned into something an evaluator can decide",
  "description": "Muse Spark drafts it from the instruction; a person approves it once. The fixer may read it but never edit it.",
  "type": "object",
  "required": [
    "format",
    "id",
    "instruction",
    "objects",
    "assertion"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": [
        "expectrail.test-spec/v0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "instruction": {
      "type": "string"
    },
    "objects": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "description": "a short noun phrase for SAM 3.1; no positions (Meta advises keeping them out of prompts)"
          },
          "minScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "object"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "visible"
            },
            "object": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "minFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "object",
            "region"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "inside-region"
            },
            "object": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "region": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "box"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "box": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4,
                      "description": "[x0, y0, x1, y1] in pixels of the captured frame, y down"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "relativeTo"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "relativeTo": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "marginPx": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "tolerancePx": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "object",
            "boundary"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "never-crosses"
            },
            "object": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "boundary": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "relativeTo",
                    "edge",
                    "side"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "relativeTo": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "edge": {
                      "enum": [
                        "top",
                        "bottom",
                        "left",
                        "right"
                      ]
                    },
                    "side": {
                      "enum": [
                        "above",
                        "below",
                        "left-of",
                        "right-of"
                      ]
                    },
                    "tolerancePx": {
                      "type": "number",
                      "minimum": 0
                    },
                    "requireOverlap": {
                      "type": "boolean",
                      "description": "only judge frames where the two objects overlap on the other axis (default true)"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "axis",
                    "value",
                    "side"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "axis": {
                      "enum": [
                        "x",
                        "y"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "side": {
                      "enum": [
                        "above",
                        "below",
                        "left-of",
                        "right-of"
                      ]
                    },
                    "tolerancePx": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "object",
            "goal"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "reaches"
            },
            "object": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "goal": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "distancePx": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fromFrame": {
          "type": "integer",
          "minimum": 0
        },
        "toFrame": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval": {
      "type": "object",
      "description": "A person's approval. Written by `python3 -m expectrail.spec_writer approve`, never by hand and never by an agent. With specSha256 the approval binds to the spec's content (issue #420): a reader that finds the digest does not match the body treats the spec as not approved. An approval without specSha256 was written before content binding; it still counts, and readers name it so.",
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "specSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the spec's canonical JSON with approval removed: keys sorted, separators ',' and ':', no ASCII escaping, UTF-8 (expectrail.approval.spec_sha256)."
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Evidence obligations, not a change to the assertion. Every applicable check is required. Named routes must be selected; other routes are not-applicable. Checkpoints use the engine trace, in world coordinates.",
      "properties": {
        "minFrames": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum distinct judged frames. Default two, capped by an explicitly one-frame window; reaches defaults to one."
        },
        "minFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum judged share of the whole window. Combined with minFrames using the stricter requirement."
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 64
          }
        },
        "reached": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "on-floor"
                  },
                  "fromTick": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "box"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "position-region"
                  },
                  "fromTick": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "box": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "coin-count-change"
                  },
                  "fromTick": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "description": "All checkpoints must occur at or after fromTick (default 0). on-floor: bound player onFloor is true; position-region: player point inside inclusive world box; coin-count-change: observed coin count differs from the first eligible tick."
        }
      }
    }
  }
}
