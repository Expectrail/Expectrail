# Copy to .env (gitignored) and fill in. Never commit .env.
# With nothing below changed, Expectrail runs on Meta's models exactly as before.

# ---------------------------------------------------------------------------
# Meta (the default). Claim a key at https://dev.meta.ai (LLM_…).
# ---------------------------------------------------------------------------
META_API_KEY=
# Wonder / Spark / SAM read MODEL_API_KEY. With SAM on, make it a second key, so the fixer
# (which receives META_API_KEY) never holds the verifier's key.
MODEL_API_KEY=
# Optional override (default https://api.meta.ai/v1)
# META_API_BASE=https://api.meta.ai/v1
# Open weights: Muse Spark Open (Baseten) and Muse Glimmer (Fireworks)
# BASETEN_API_KEY=
# FIREWORKS_API_KEY=

# ---------------------------------------------------------------------------
# Bring your own model (expectrail.providers). Uncomment to use.
# A Meta key above wins unless EXPECTRAIL_LLM_PROVIDER is set.
# Providers: anthropic | openai | gemini | openrouter | ollama | vllm | meta | baseten | fireworks
# ---------------------------------------------------------------------------
# EXPECTRAIL_LLM_PROVIDER=anthropic
# EXPECTRAIL_LLM_MODEL=claude-sonnet-5-5
# EXPECTRAIL_LLM_API_BASE=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Per role, overriding the line above: EXPECTRAIL_SPEC_*, EXPECTRAIL_TRIAGE_*, EXPECTRAIL_FIXER_*,
# EXPECTRAIL_VLM_* (PROVIDER, MODEL, API_BASE, API_KEY)

# Fully local, no key:
# EXPECTRAIL_LLM_PROVIDER=ollama
# EXPECTRAIL_LLM_API_BASE=http://localhost:11434/v1
# EXPECTRAIL_LLM_MODEL=qwen2.5-coder:32b

# ---------------------------------------------------------------------------
# Bring your own coding agent (agents.byo_fixer). Unset = Muse Code.
# claude-code | codex | aider | llm-patch | custom-cmd
# Runs in the fixer workspace under bubblewrap when available, with only its own provider key.
# ---------------------------------------------------------------------------
# EXPECTRAIL_FIXER_AGENT=claude-code
# EXPECTRAIL_FIXER_CMD="my-agent --workdir {worktree} --prompt-file {prompt_file}"
# Agent installed under $HOME? Bind its install read-only into the sandbox (colon-separated):
# EXPECTRAIL_FIXER_RO_BINDS=/home/me/.local/share/claude

# ---------------------------------------------------------------------------
# Vision backend: sam | glimmer | both | glimmer-engine | local-http | byo-vlm-engine | byo-vlm
# A vision-language model alone (glimmer, byo-vlm) does not decide a verdict; use its -engine form.
# ---------------------------------------------------------------------------
# EXPECTRAIL_VISION_BACKEND=sam
# EXPECTRAIL_LOCAL_VISION_URL=http://localhost:8090/detect
# EXPECTRAIL_VLM_PROVIDER=gemini
# EXPECTRAIL_VLM_API_KEY=     # its own key: never the one the fixer receives
# EXPECTRAIL_VLM_COORDS=norm1000
# EXPECTRAIL_KEYFRAMES_ONLY=1
